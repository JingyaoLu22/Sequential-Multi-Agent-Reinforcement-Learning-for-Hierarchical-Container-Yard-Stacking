{
  "environment": {
    "vessel_shape": [
      4,
      4,
      4
    ],
    "yard_shape": [
      4,
      5,
      4
    ],
    "num_containers": 64,
    "group_num": 4,
    "group_placement": "random",
    "observation_type": "stack_features_v3",
    "reward_norm": true,
    "reward_clip": true,
    "stack_fill_penalty": true,
    "container_sizes": true,
    "enable_imo": true,
    "seed": 1
  },
  "algorithm": {
