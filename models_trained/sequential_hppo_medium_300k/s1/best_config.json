    "total_timesteps": 300000,
    "learning_rate": 0.0001,
    "buffer_size": 4096,
    "batch_size": 128,
    "n_epochs": 3,
    "clip_range": 0.2,
    "ent_coef": 0.15,
    "checkpoint_freq": 100000,
    "embed_dim": 128,
    "n_heads": 4,
    "n_layers": 2,
    "dropout": 0.1,
    "vf_dim": 128,
    "tanh_clipping": 10.0,
    "container_start": 2,
    "container_dim": 1,
    "include_container_in_encoder": true,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "normalize_advantage": true,
    "eval_freq": 10000,
    "n_eval_episodes": 20
  }
